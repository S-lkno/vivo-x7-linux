+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x28, 0x00);
+	mipi_dsi_msleep(&dsi_ctx, 50);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x10, 0x00);
+	mipi_dsi_msleep(&dsi_ctx, 150);
+
+	return dsi_ctx.accum_err;
+}
+
+static int d8064t_prepare(struct drm_panel *panel)
+{
+	struct d8064t *ctx = to_d8064t(panel);
+	struct device *dev = &ctx->dsi->dev;
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(d8064t_supplies), ctx->supplies);
+	if (ret < 0) {
+		dev_err(dev, "Failed to enable regulators: %d\n", ret);
+		return ret;
+	}
+
+	d8064t_reset(ctx);
+
+	ret = d8064t_on(ctx);
+	if (ret < 0) {
+		dev_err(dev, "Failed to initialize panel: %d\n", ret);
+		gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+		regulator_bulk_disable(ARRAY_SIZE(d8064t_supplies), ctx->supplies);
+		return ret;
+	}
+
+	return 0;
+}
+
+static int d8064t_unprepare(struct drm_panel *panel)
+{
+	struct d8064t *ctx = to_d8064t(panel);
+	struct device *dev = &ctx->dsi->dev;
+	int ret;
+
+	ret = d8064t_off(ctx);
+	if (ret < 0)
+		dev_err(dev, "Failed to un-initialize panel: %d\n", ret);
+
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	regulator_bulk_disable(ARRAY_SIZE(d8064t_supplies), ctx->supplies);
+
+	return 0;
+}
+
+static const struct drm_display_mode d8064t_mode = {
+	.clock = (1080 + 80 + 8 + 158) * (1920 + 30 + 2 + 40) * 60 / 1000,
+	.hdisplay = 1080,
+	.hsync_start = 1080 + 80,
+	.hsync_end = 1080 + 80 + 8,
+	.htotal = 1080 + 80 + 8 + 158,
+	.vdisplay = 1920,
+	.vsync_start = 1920 + 30,
+	.vsync_end = 1920 + 30 + 2,
+	.vtotal = 1920 + 30 + 2 + 40,
+	.width_mm = 64,
+	.height_mm = 115,
+	.type = DRM_MODE_TYPE_DRIVER,
+};
+
+static int d8064t_get_modes(struct drm_panel *panel,
+			    struct drm_connector *connector)
+{
+	return drm_connector_helper_get_modes_fixed(connector, &d8064t_mode);
+}
+
+static const struct drm_panel_funcs d8064t_panel_funcs = {
+	.prepare = d8064t_prepare,
+	.unprepare = d8064t_unprepare,
+	.get_modes = d8064t_get_modes,
+};
+
+static int d8064t_bl_update_status(struct backlight_device *bl)
+{
+	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	u16 brightness = backlight_get_brightness(bl);
+	int ret;
+
+	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+
+	ret = mipi_dsi_dcs_set_display_brightness(dsi, brightness);
+	if (ret < 0)
+		return ret;
+
+	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	return 0;
+}
+
+// TODO: Check if /sys/class/backlight/.../actual_brightness actually returns
+// correct values. If not, remove this function.
+static int d8064t_bl_get_brightness(struct backlight_device *bl)
+{
+	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	u16 brightness;
+	int ret;
+
+	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+
+	ret = mipi_dsi_dcs_get_display_brightness(dsi, &brightness);
+	if (ret < 0)
+		return ret;
+
+	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	return brightness & 0xff;
+}
+
+static const struct backlight_ops d8064t_bl_ops = {
+	.update_status = d8064t_bl_update_status,
+	.get_brightness = d8064t_bl_get_brightness,
+};
+
+static struct backlight_device *
+d8064t_create_backlight(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	const struct backlight_properties props = {
+		.type = BACKLIGHT_RAW,
+		.brightness = 255,
+		.max_brightness = 255,
+	};
+
+	return devm_backlight_device_register(dev, dev_name(dev), dev, dsi,
+					      &d8064t_bl_ops, &props);
+}
+
+static int d8064t_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct d8064t *ctx;
+	int ret;
+
+	ctx = devm_drm_panel_alloc(dev, struct d8064t, panel,
+				   &d8064t_panel_funcs,
+				   DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+
+	ret = devm_regulator_bulk_get_const(dev,
+					    ARRAY_SIZE(d8064t_supplies),
+					    d8064t_supplies,
+					    &ctx->supplies);
+	if (ret < 0)
+		return ret;
+
+	ctx->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(ctx->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio),
+				     "Failed to get reset-gpios\n");
+
+	ctx->dsi = dsi;
+	mipi_dsi_set_drvdata(dsi, ctx);
+
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	dsi->mode_flags = MIPI_DSI_MODE_NO_EOT_PACKET |
+			  MIPI_DSI_CLOCK_NON_CONTINUOUS;
+
+	ctx->panel.prepare_prev_first = true;
+
+	ctx->panel.backlight = d8064t_create_backlight(dsi);
+	if (IS_ERR(ctx->panel.backlight))
+		return dev_err_probe(dev, PTR_ERR(ctx->panel.backlight),
+				     "Failed to create backlight\n");
+
+	drm_panel_add(&ctx->panel);
+
+	ret = mipi_dsi_attach(dsi);
+	if (ret < 0) {
+		drm_panel_remove(&ctx->panel);
+		return dev_err_probe(dev, ret, "Failed to attach to DSI host\n");
+	}
+
+	return 0;
+}
+
+static void d8064t_remove(struct mipi_dsi_device *dsi)
+{
+	struct d8064t *ctx = mipi_dsi_get_drvdata(dsi);
+	int ret;
+
+	ret = mipi_dsi_detach(dsi);
+	if (ret < 0)
+		dev_err(&dsi->dev, "Failed to detach from DSI host: %d\n", ret);
+
+	drm_panel_remove(&ctx->panel);
+}
+
+static const struct of_device_id d8064t_of_match[] = {
+	{ .compatible = "mdss,d8064t" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, d8064t_of_match);
+
+static struct mipi_dsi_driver d8064t_driver = {
+	.probe = d8064t_probe,
+	.remove = d8064t_remove,
+	.driver = {
+		.name = "panel-d8064t",
+		.of_match_table = d8064t_of_match,
+	},
+};
+module_mipi_dsi_driver(d8064t_driver);
+
+MODULE_AUTHOR("Vivo X7 mainline port");
+MODULE_DESCRIPTION("DRM driver for mdss_dsi_d8064t_1080p_cmd panel");
+MODULE_LICENSE("GPL");
