--- a/drivers/input/touchscreen/cyttsp_button.c
+++ b/drivers/input/touchscreen/cyttsp_button.c
@@ -0,0 +1,271 @@
+// SPDX-License-Identifier: GPL-2.0
+/* Minimal Cypress capacitive button driver for Vivo PD1619. */
+
+#include <linux/delay.h>
+#include <linux/i2c.h>
+#include <linux/input.h>
+#include <linux/interrupt.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/regulator/consumer.h>
+#include <linux/slab.h>
+
+#define CYTTSP_MAX_KEYS 8
+
+struct cyttsp_button {
+	struct i2c_client *client;
+	struct input_dev *input;
+	struct regulator *vcc_i2c;
+	struct mutex io_lock;
+	u32 keycodes[CYTTSP_MAX_KEYS];
+	u32 key_count;
+	u32 irq_flags;
+	u8 status_reg;
+	u8 last_status;
+	bool regulator_enabled;
+	bool suspended;
+};
+
+static int cyttsp_button_read_reg(struct cyttsp_button *button, u8 reg,
+		u8 *value)
+{
+	int ret;
+
+	mutex_lock(&button->io_lock);
+	ret = i2c_master_send(button->client, &reg, 1);
+	if (ret == 1)
+		ret = i2c_master_recv(button->client, value, 1);
+	mutex_unlock(&button->io_lock);
+
+	if (ret == 1)
+		return 0;
+	return ret < 0 ? ret : -EIO;
+}
+
+static int cyttsp_button_set_power(struct cyttsp_button *button, bool on)
+{
+	int ret;
+
+	if (on && !button->regulator_enabled) {
+		ret = regulator_enable(button->vcc_i2c);
+		if (ret)
+			return ret;
+		button->regulator_enabled = true;
+	}
+
+	if (!on && button->regulator_enabled) {
+		regulator_disable(button->vcc_i2c);
+		button->regulator_enabled = false;
+	}
+
+	return 0;
+}
+
+static irqreturn_t cyttsp_button_irq(int irq, void *data)
+{
+	struct cyttsp_button *button = data;
+	u8 changed;
+	u8 status;
+	int i;
+
+	if (button->suspended)
+		return IRQ_HANDLED;
+
+	if (cyttsp_button_read_reg(button, button->status_reg, &status))
+		return IRQ_HANDLED;
+
+	changed = status ^ button->last_status;
+	for (i = 0; i < button->key_count; i++) {
+		if (!(changed & BIT(i)))
+			continue;
+		input_report_key(button->input, button->keycodes[i],
+				!!(status & BIT(i)));
+	}
+	if (changed)
+		input_sync(button->input);
+	button->last_status = status;
+
+	return IRQ_HANDLED;
+}
+
+static int cyttsp_button_parse_dt(struct device *dev,
+		struct cyttsp_button *button)
+{
+	struct device_node *np = dev->of_node;
+	u32 value;
+	int ret;
+
+	ret = of_property_read_u32(np, "cyttsp,irqflags", &button->irq_flags);
+	if (ret)
+		return ret;
+
+	ret = of_property_read_u32(np, "cyttsp,button-status-reg", &value);
+	if (ret)
+		return ret;
+	button->status_reg = value;
+
+	ret = of_property_read_u32(np, "cyttsp,key-num", &button->key_count);
+	if (ret || !button->key_count || button->key_count > CYTTSP_MAX_KEYS)
+		return -EINVAL;
+
+	return of_property_read_u32_array(np, "cyttsp,key-codes",
+			button->keycodes, button->key_count);
+}
+
+static int cyttsp_button_probe(struct i2c_client *client)
+{
+	struct cyttsp_button *button;
+	int ret;
+	int i;
+
+	if (!client->dev.of_node)
+		return -ENODEV;
+
+	button = devm_kzalloc(&client->dev, sizeof(*button), GFP_KERNEL);
+	if (!button)
+		return -ENOMEM;
+	button->client = client;
+	mutex_init(&button->io_lock);
+
+	ret = cyttsp_button_parse_dt(&client->dev, button);
+	if (ret)
+		return ret;
+
+	button->vcc_i2c = devm_regulator_get(&client->dev, "vcc_i2c");
+	if (IS_ERR(button->vcc_i2c))
+		return PTR_ERR(button->vcc_i2c);
+
+	ret = cyttsp_button_set_power(button, true);
+	if (ret)
+		return ret;
+	msleep(110);
+
+	button->input = input_allocate_device();
+	if (!button->input) {
+		ret = -ENOMEM;
+		goto err_power_off;
+	}
+	button->input->name = "vivo_virtual_key";
+	button->input->id.bustype = BUS_I2C;
+	button->input->dev.parent = &client->dev;
+	for (i = 0; i < button->key_count; i++)
+		input_set_capability(button->input, EV_KEY, button->keycodes[i]);
+
+	ret = input_register_device(button->input);
+	if (ret)
+		goto err_free_input;
+
+	if (client->irq <= 0) {
+		ret = -EINVAL;
+		goto err_unregister_input;
+	}
+
+	ret = devm_request_threaded_irq(&client->dev, client->irq, NULL,
+			cyttsp_button_irq, button->irq_flags | IRQF_ONESHOT,
+			dev_name(&client->dev), button);
+	if (ret)
+		goto err_unregister_input;
+
+	i2c_set_clientdata(client, button);
+	dev_info(&client->dev, "registered %u capacitive keys\n",
+			button->key_count);
+	return 0;
+
+err_unregister_input:
+	input_unregister_device(button->input);
+	button->input = NULL;
+	goto err_power_off;
+err_free_input:
+	input_free_device(button->input);
+	button->input = NULL;
+err_power_off:
+	cyttsp_button_set_power(button, false);
+	return ret;
+}
+
+static void cyttsp_button_remove(struct i2c_client *client)
+{
+	struct cyttsp_button *button = i2c_get_clientdata(client);
+
+	input_unregister_device(button->input);
+	button->input = NULL;
+	cyttsp_button_set_power(button, false);
+}
+
+static void cyttsp_button_shutdown(struct i2c_client *client)
+{
+	struct cyttsp_button *button = i2c_get_clientdata(client);
+
+	if (button)
+		cyttsp_button_set_power(button, false);
+}
+
+#ifdef CONFIG_PM_SLEEP
+static int cyttsp_button_suspend(struct device *dev)
+{
+	struct i2c_client *client = to_i2c_client(dev);
+	struct cyttsp_button *button = i2c_get_clientdata(client);
+
+	button->suspended = true;
+	disable_irq(client->irq);
+	cyttsp_button_set_power(button, false);
+	return 0;
+}
+
+static int cyttsp_button_resume(struct device *dev)
+{
+	struct i2c_client *client = to_i2c_client(dev);
+	struct cyttsp_button *button = i2c_get_clientdata(client);
+
+	cyttsp_button_set_power(button, true);
+	msleep(110);
+	cyttsp_button_read_reg(button, button->status_reg, &button->last_status);
+	button->suspended = false;
+	enable_irq(client->irq);
+	return 0;
+}
+#endif
+
+static SIMPLE_DEV_PM_OPS(cyttsp_button_pm_ops, cyttsp_button_suspend,
+		cyttsp_button_resume);
+
+static const struct of_device_id cyttsp_button_of_match[] = {
+	{ .compatible = "cyttsp,cyttsp-button" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, cyttsp_button_of_match);
+
+static const struct i2c_device_id cyttsp_button_id[] = {
+	{ "cyttsp-button", 0 },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, cyttsp_button_id);
+
+static struct i2c_driver cyttsp_button_driver = {
+	.driver = {
+		.name = "cyttsp-button",
+		.owner = THIS_MODULE,
+		.of_match_table = cyttsp_button_of_match,
+		.pm = &cyttsp_button_pm_ops,
+	},
+	.probe = cyttsp_button_probe,
+	.remove = cyttsp_button_remove,
+	.shutdown = cyttsp_button_shutdown,
+	.id_table = cyttsp_button_id,
+};
+
+static int __init cyttsp_button_init(void)
+{
+	return i2c_add_driver(&cyttsp_button_driver);
+}
+late_initcall(cyttsp_button_init);
+
+static void __exit cyttsp_button_exit(void)
+{
+	i2c_del_driver(&cyttsp_button_driver);
+}
+module_exit(cyttsp_button_exit);
+
+MODULE_DESCRIPTION("Cypress capacitive button driver for Vivo PD1619");
+MODULE_LICENSE("GPL v2");
